import { NextResponse } from 'next/server';
import { getDb } from '@/lib/data';
import { ObjectId } from 'mongodb';
import { getSession } from '@/lib/auth';
import crypto from 'crypto';

interface VendorApplication {
  _id: ObjectId;
  name: string;
  email: string;
  phone: string;
  service: string;
  contactPerson: string;
  taxId: string;
  address: {
    street: string;
    city: string;
    state: string;
    zipCode: string;
    country: string;
  };
  status: 'pending' | 'approved' | 'rejected';
  paymentTerms: string;
  notes: string;
  companyId: string | ObjectId;
  applicationId: string;
  inviteToken?: string;
  inviteTokenExpiresAt?: Date;
  createdAt: Date;
  updatedAt: Date;
  reviewedBy?: string | ObjectId;
  reviewedAt?: Date;
}

// PATCH /api/vendor-applications/[id] - Approve or reject a vendor application
export async function PATCH(
  request: Request,
  { params }: { params: { id: string } }
) {
  try {
    const session = await getSession();
    if (!session?.companyId) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const db = await getDb();
    const body = await request.json();
    const { status, notes, generateToken } = body;

    // Validate status
    if (!['approved', 'rejected'].includes(status)) {
      return NextResponse.json(
        { error: 'Invalid status. Must be "approved" or "rejected"' },
        { status: 400 }
      );
    }

    // Validate application ID
    if (!ObjectId.isValid(params.id)) {
      return NextResponse.json(
        { error: 'Invalid application ID' },
        { status: 400 }
      );
    }

    // Find the application
    const application = await db.collection<VendorApplication>('vendorApplications').findOne({
      _id: new ObjectId(params.id),
      targetCompanyId: new ObjectId(session.companyId)
    });

    if (!application) {
      return NextResponse.json(
        { error: 'Application not found' },
        { status: 404 }
      );
    }

    // Generate a secure token for vendor access if approved
    let inviteToken: string | null = null;
    let inviteLink: string | null = null;
    
    if (status === 'approved' && generateToken) {
      inviteToken = crypto.randomBytes(32).toString('hex');
      inviteLink = `${process.env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000'}/vendor-portal?token=${inviteToken}`;
    }

    // Update application status
    const updateData: Partial<VendorApplication> = {
      status: status as 'approved' | 'rejected',
      updatedAt: new Date(),
      reviewedBy: new ObjectId(session.id),
      reviewedAt: new Date(),
    };

    if (inviteToken) {
      updateData.inviteToken = inviteToken;
      updateData.inviteTokenExpiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000); // 30 days
    }

    if (notes) {
      updateData.notes = notes;
    }

    // Update the application
    const result = await db.collection<VendorApplication>('vendorApplications').findOneAndUpdate(
      { _id: new ObjectId(params.id) },
      { $set: updateData },
      { returnDocument: 'after' }
    );

    // If approved, create vendor record
    if (status === 'approved' && result.value) {
      const vendorData = {
        name: result.value.name || '',
        email: result.value.email || '',
        phone: result.value.phone || '',
        service: result.value.service || '',
        contactPerson: result.value.contactPerson || '',
        taxId: result.value.taxId || '',
        address: result.value.address || {
          street: '',
          city: '',
          state: '',
          zipCode: '',
          country: ''
        },
        status: 'Active',
        paymentTerms: result.value.paymentTerms || 'Net 30',
        notes: result.value.notes || '',
        companyId: new ObjectId(session.companyId),
        applicationId: result.value.applicationId || '',
        createdAt: new Date(),
        updatedAt: new Date()
      };

      await db.collection('vendors').insertOne(vendorData);

      // Send approval email if approved (in a real app)
      try {
        console.log('Sending approval email to:', result.value.email);
        console.log('Vendor dashboard link:', inviteLink);
        // await sendApprovalEmail(result.value.email, inviteLink);
      } catch (emailError) {
        console.error('Failed to send approval email:', emailError);
      }
    }

    return NextResponse.json({ 
      success: true, 
      message: `Application ${status} successfully`,
      status,
      inviteToken,
      inviteLink
    });
  } catch (error) {
    console.error('Error processing vendor application:', error);
    return NextResponse.json(
      { error: 'Failed to process application' },
      { status: 500 }
    );
  }
}

// GET /api/vendor-applications/[id] - Get a specific vendor application
export async function GET(
  request: Request,
  { params }: { params: { id: string } }
) {
  try {
    const session = await getSession();
    if (!session?.companyId) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const db = await getDb();

    // Validate application ID
    if (!ObjectId.isValid(params.id)) {
      return NextResponse.json(
        { error: 'Invalid application ID' },
        { status: 400 }
      );
    }

    // Find the application
    const application = await db.collection<VendorApplication>('vendorApplications').findOne({
      _id: new ObjectId(params.id),
      targetCompanyId: new ObjectId(session.companyId)
    });

    if (!application) {
      return NextResponse.json(
        { error: 'Application not found' },
        { status: 404 }
      );
    }

    // Convert ObjectId to string
    const { _id, ...applicationData } = application;
    const result = { ...applicationData, id: _id.toString() };

    return NextResponse.json(result);
  } catch (error) {
    console.error('Error fetching vendor application:', error);
    return NextResponse.json(
      { error: 'Failed to fetch application' },
      { status: 500 }
    );
  }
}
