# ====================================================================
#          ENVIRONMENT VARIABLES TEMPLATE FOR VENDORVERSE
# ====================================================================
#
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to .env.local
# 2. Fill in the values for each variable below.
# 3. DO NOT commit the .env.local file to version control.

# --------------------------------------------------------------------
# Next.js Public Variables
# --------------------------------------------------------------------
# The base URL of your application, used for generating absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# Security & Authentication
# --------------------------------------------------------------------
# A 64-character (32-byte) hex string for encrypting sensitive data like invite tokens.
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --------------------------------------------------------------------
# Email Service (Resend)
# --------------------------------------------------------------------
# Your API key from Resend for sending emails.
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=

# --------------------------------------------------------------------
# Database (MongoDB)
# --------------------------------------------------------------------
# Your MongoDB connection string.
# Example: mongodb+srv://<user>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
DATABASE_URL=
