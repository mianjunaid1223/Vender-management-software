# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vendorverse?retryWrites=true&w=majority

# Authentication Secrets
AUTH_SECRET=your-super-secret-jwt-key-here
VENDOR_AUTH_SECRET=your-vendor-specific-jwt-secret-here

# AI Configuration (Optional)
GOOGLE_GENAI_API_KEY=your_google_ai_api_key_here

# Email Configuration (Optional)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@vendormanagement.com
FROM_NAME=Vendor Management System

# Application Configuration
NEXTAUTH_URL=http://localhost:9002
NODE_ENV=development

# Vendor Portal Configuration
VENDOR_PORTAL_ENABLED=true