  "databaseSchema": {
    "users": {
      "fields": ["_id", "email", "password", "name", "companyId", "role", "createdAt"],
      "multiTenant": true,
      "tenantKey": "companyId"
    },
    "companies": {
      "fields": ["_id", "name", "businessType", "industry", "addresses", "contacts", "taxInfo", "preferences"],
      "multiTenant": false,
      "purpose": "Tenant isolation and company data"
    },
    "vendors": {
      "fields": ["_id", "name", "email", "phone", "service", "companyId", "address", "status", "rating", "tags"],
      "multiTenant": true,
      "tenantKey": "companyId"
    },
    "invoices": {
      "fields": ["_id", "invoiceNumber", "invoiceDate", "dueDate", "companyId", "vendorId", "items", "total", "status"],
      "multiTenant": true,
      "tenantKey": "companyId"
    },
    "contracts": {
      "fields": ["_id", "title", "vendorId", "companyId", "status", "startDate", "endDate", "value", "terms"],
      "multiTenant": true,
      "tenantKey": "companyId"
    },
    "vendor_applications": {
      "fields": ["_id", "applicationId", "vendorName", "email", "targetCompanyId", "status", "submittedAt"],
      "multiTenant": true,
      "tenantKey": "targetCompanyId"
    }
  },
